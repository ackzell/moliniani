{
  "name": "@moliniani/components",
  "version": "0.0.1",
  "description": "Reusable Motion Canvas nodes and Vue SFC components for Moliniani projects.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./vue": "./dist/vue/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "gen": "node scripts/compile-vue.mjs",
    "prebuild": "node scripts/compile-vue.mjs",
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "node scripts/compile-vue.mjs && vp test",
    "check": "node scripts/compile-vue.mjs && vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@moliniani/core": "workspace:*",
    "animejs": "catalog:"
  },
  "devDependencies": {
    "@motion-canvas/2d": "catalog:",
    "@motion-canvas/core": "catalog:",
    "@types/node": "^25.9.5",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vue/compiler-sfc": "catalog:",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.7",
    "vite-plus": "catalog:",
    "vue": "catalog:"
  },
  "peerDependencies": {
    "@motion-canvas/2d": "catalog:",
    "@motion-canvas/core": "catalog:",
    "vue": "catalog:"
  }
}
